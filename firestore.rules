rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // PHASE 0 LOCKDOWN (2026-08-07): The research study is complete and all
    // data has been exported and archived. Deny all client access until the
    // Phase 1 multi-tenant auth model (School > Teacher > Class > Pupil)
    // defines real, scoped rules. See PRODUCT-ROADMAP.md.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
